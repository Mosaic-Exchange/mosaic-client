<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>

<!--
    Settings screen — structural placeholder.

    TODO APP-5 (#9) — Full implementation
        AC1: Add three sections (as separate VBox panels or a TabPane):
               - Privacy & Sharing   (toggles)
               - Network Configuration (dropdowns + text field for bootstrap nodes)
               - Adapter Management  (list + action buttons)
        AC2: Make all toggles/dropdowns/text fields interactive (bound to local state)
        AC3: "Save" button → print current values to console OR show confirmation Alert
        AC4: "Cancel" button → Navigator.showWorkspace()
               (chosen behaviour: navigate back without saving — document this in PR)
        AC5: No persistence required
-->
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mosaic.client.ui.screens.settings.SettingsController"
            styleClass="settings-screen">

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 32 40 32 40;">

                <!-- Page title -->
                <Label text="Settings" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <!-- Error label -->
                <Label fx:id="errorLabel" wrapText="true" managed="${errorLabel.visible}" 
                style="-fx-text-fill: #f44336; -fx-font-size: 13px;"/>

                <!-- ── Network Configuration ── -->
                <VBox spacing="12" styleClass="settings-section">
                    <Label text="Network Configuration" styleClass="section-title"/>
                    <Separator/>

                    <!-- ── Status ── -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Status" minWidth="160"/>
                        <Label fx:id="networkStatusLabel" text="Unknown"/>
                    </HBox>

                    <!-- ── Port Field ── -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Port" minWidth="160"/>
                        <VBox spacing="2">
                            <TextField fx:id="portField" prefWidth="120" promptText="e.g. 7000"/>
                            <Label text="The port this node listens on (0–65535)." styleClass="hint-label"/>
                        </VBox>
                    </HBox>

                     <!-- ── LLM Server Port ── -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="LLM Server Port" minWidth="160"/>
                        <VBox spacing="2">
                            <TextField fx:id="llmServerPortField" prefWidth="120" promptText="e.g. 4000"/>
                            <Label text="Port for the local LLM middleware server (0–65535)." styleClass="hint-label"/>
                        </VBox>
                    </HBox>

                    <!-- ── Node Type ── -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Node Type" minWidth="160"/>
                        <VBox spacing="2">
                            <ComboBox fx:id="nodeTypeCombo" prefWidth="160"/>
                            <Label text="basic = normal node, seed = bootstrap node, master = coordinator." styleClass="hint-label"/>
                        </VBox>
                    </HBox>

                    <!-- ── Seed Address ── -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Seed Address" minWidth="160"/>
                        <VBox spacing="2">
                            <TextField fx:id="seedField" prefWidth="240" promptText="e.g. 127.0.0.1:7001"/>
                            <Label text="Required when Node Type is &quot;seed&quot;. Format: ip:port" styleClass="hint-label"/>
                        </VBox>
                    </HBox>

                </VBox>

                <!-- ── Debug & Storage ── -->
                <VBox spacing="12" styleClass="settings-section">
                    <Label text="Debug &amp; Storage" styleClass="section-title"/>
                    <Separator/>

                    <!-- ── Checkbox for debugEnabled ── -->
                    <CheckBox fx:id="debugEnabledCheck" text="Enable debug snapshots"/>
                    <Label text="Periodically writes a debug snapshot file while the node is running." styleClass="hint-label"/>

                    <!-- ── Data Directory Field & Browse Button ── -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Data Directory" minWidth="160"/>
                        <VBox spacing="2">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <TextField fx:id="dataDirField" prefWidth="300"/>
                                <Button fx:id="browseDirBtn" text="Browse…" mnemonicParsing="false"/>
                            </HBox>
                            <Label text="Where the database and adapters are stored." styleClass="hint-label"/>
                        </VBox>
                    </HBox>

                </VBox>

                <!-- ── Save / Cancel ── -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="Reset to Defaults" onAction="#onResetDefaults" />
                    <Button text="Cancel" onAction="#onCancel" mnemonicParsing="false"/>
                    <Button text="Save"   onAction="#onSave"   mnemonicParsing="false"
                            defaultButton="true"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
