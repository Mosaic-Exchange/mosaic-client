<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Main Workspace screen — layout structure only (APP-MW-1, #11).

    Panel content is intentionally left as placeholders.
    Teammates: fill in your assigned panel below:
      - Top header    → APP-MW-4 (#14): active expert status bar
      - Left sidebar  → APP-MW-2 (#12): session list + new/search buttons
      - Center panel  → APP-MW-2 (#12): chat history
                        APP-MW-3 (#13): message input + send
      - Right panel   → APP-MW-4 (#14): expert metadata
                        APP-MW-5 (#15): End Session / Clear Context controls
-->
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mosaic.client.ui.screens.workspace.MainWorkspaceController"
            styleClass="workspace-screen">

    <!-- TOP — expert status header placeholder -->
    <top>
        <HBox styleClass="workspace-header" alignment="CENTER_LEFT" minHeight="52">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <!-- TODO APP-MW-4 (#14): Replace with active expert name, source, mode and Switch Expert button -->
            <Label text="[Header] Active Expert Status — see #14" styleClass="panel-placeholder-label"/>
        </HBox>
    </top>

    <!-- LEFT — session list sidebar placeholder -->
    <left>
        <VBox styleClass="workspace-sidebar" prefWidth="220" alignment="TOP_CENTER">
            <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
            <!-- TODO APP-MW-2 (#12): Replace with New Session button, Search Session button, session list -->
            <Label text="[Sidebar] Session List — see #12" styleClass="panel-placeholder-label" wrapText="true"/>
        </VBox>
    </left>

    <!-- CENTER — chat history + message input placeholder -->
    <center>
        <BorderPane styleClass="chat-panel">
            <center>
                <!-- chatHistory VBox is the append target for messages (APP-MW-3, #13).
                     TODO APP-MW-2 (#12): Prepopulate chatHistory with hardcoded sample messages. -->
                <ScrollPane fx:id="chatScrollPane" fitToWidth="true"
                            styleClass="chat-scroll" hbarPolicy="NEVER">
                    <VBox fx:id="chatHistory" styleClass="chat-history" spacing="10">
                        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                    </VBox>
                </ScrollPane>
            </center>
            <bottom>
                <!-- AC1: text input field, AC2: Send button -->
                <HBox styleClass="input-area" spacing="8" alignment="CENTER">
                    <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
                    <TextArea fx:id="messageInput" styleClass="message-input"
                              HBox.hgrow="ALWAYS" prefRowCount="2" wrapText="true"
                              promptText="Type a message… (Enter to send, Shift+Enter for new line)"/>
                    <Button text="Send" styleClass="btn-cta" onAction="#onSend"/>
                </HBox>
            </bottom>
        </BorderPane>
    </center>

    <!-- RIGHT — expert details panel + workspace controls -->
    <right>
        <VBox styleClass="expert-panel" prefWidth="200" alignment="TOP_CENTER">
            <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
            <!-- TODO APP-MW-4 (#14): Replace with expert metadata labels -->
            <Label text="[Right] Expert Details — see #14" styleClass="panel-placeholder-label" wrapText="true"/>

            <!-- Spacer pushes controls to the bottom -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- APP-MW-5 (#15): Workspace control buttons -->
            <VBox styleClass="workspace-controls" spacing="10" alignment="BOTTOM_CENTER">
                <Button fx:id="switchExpertBtn" text="Switch Expert" styleClass="btn-primary"
                        maxWidth="Infinity" onAction="#onSwitchExpert"/>
                <Button fx:id="clearContextBtn" text="Clear Context" styleClass="btn-secondary"
                        maxWidth="Infinity" onAction="#onClearContext"/>
                <Button fx:id="endSessionBtn" text="End Session" styleClass="btn-primary"
                        maxWidth="Infinity" onAction="#onEndSession"/>
            </VBox>
        </VBox>
    </right>

</BorderPane>
