<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ListView?>

<!--
    Main Workspace screen — layout structure only (APP-MW-1, #11).

    Panel content is intentionally left as placeholders.
    Teammates: fill in your assigned panel below:
      - Top header    → APP-MW-4 (#14): active expert status bar
      - Left sidebar  → APP-MW-2 (#12): session list + new/search buttons
      - Center panel  → APP-MW-2 (#12): chat history
                        APP-MW-3 (#13): message input + send
      - Right panel   → APP-MW-4 (#14): expert metadata
                        APP-MW-5 (#15): End Session / Clear Context controls
-->
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mosaic.client.ui.screens.workspace.MainWorkspaceController"
            styleClass="workspace-screen">

    <!-- TOP — active expert status header (APP-MW-4, #14) -->
    <top>
        <HBox styleClass="workspace-header" alignment="CENTER_LEFT" minHeight="52" spacing="12">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label fx:id="headerExpertName" text="Gardening Expert" styleClass="label-title"/>
            <Label fx:id="headerExpertSource" text="Local" styleClass="label-muted"/>
            <Label fx:id="headerExpertMode" text="Inference" styleClass="label-muted"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Switch Expert" styleClass="btn-primary" onAction="#onSwitchExpert"/>
            <Button text="Settings" styleClass="btn-primary" onAction="#onOpenSettings"/>
        </HBox>
    </top>

    <!-- LEFT — session list sidebar -->
    <left>
        <VBox styleClass="workspace-sidebar" prefWidth="220" alignment="TOP_CENTER" spacing="10">
            <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
            <Button text="New Session" onAction="#onNewSession"/>
            <ListView fx:id="sessionListView"/>
        </VBox>
    </left>

    <!-- CENTER — chat history + message input placeholder -->
    <center>
        <BorderPane styleClass="chat-panel">
            <center>
                <!-- chatHistory VBox is the append target for messages (APP-MW-3, #13).
                     TODO APP-MW-2 (#12): Prepopulate chatHistory with hardcoded sample messages. -->
                <ScrollPane fx:id="chatScrollPane" fitToWidth="true"
                            styleClass="chat-scroll" hbarPolicy="NEVER">
                    <VBox fx:id="chatHistory" styleClass="chat-history" spacing="10">
                        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                    </VBox>
                </ScrollPane>
            </center>
            <bottom>
                <!-- AC1: text input field, AC2: Send button -->
                <HBox styleClass="input-area" spacing="8" alignment="CENTER">
                    <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
                    <TextArea fx:id="messageInput" styleClass="message-input"
                              HBox.hgrow="ALWAYS" prefRowCount="2" wrapText="true"
                              promptText="Type a message… (Enter to send, Shift+Enter for new line)"/>
                    <Button fx:id="sendBtn" text="Send" styleClass="btn-cta" onAction="#onSend"/>
                </HBox>
            </bottom>
        </BorderPane>
    </center>

    <!-- RIGHT — expert details panel + workspace controls -->
    <right>
        <VBox styleClass="expert-panel" prefWidth="200" alignment="TOP_CENTER">
            <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
            <!-- APP-MW-4 (#14): Expert metadata card -->
            <VBox styleClass="card" spacing="8">
                <Label text="Expert Details" styleClass="label-title"/>
                <Separator/>
                <Label text="Name" styleClass="label-muted"/>
                <Label fx:id="metaExpertName" text="Gardening Expert" styleClass="label-body"/>
                <Label text="Domain" styleClass="label-muted"/>
                <Label fx:id="metaExpertDomain" text="Gardening" styleClass="label-body"/>
                <Label text="Source" styleClass="label-muted"/>
                <Label fx:id="metaExpertSource" text="Local" styleClass="label-body"/>
                <Label text="Adapter" styleClass="label-muted"/>
                <Label fx:id="metaAdapterFile" text="gardening_expert.gguf" styleClass="label-body" wrapText="true"/>
                <Label text="Status" styleClass="label-muted"/>
                <Label fx:id="metaExpertStatus" text="Connected" styleClass="expert-status-connected"/>
            </VBox>

            <!-- Spacer pushes controls to the bottom -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- APP-MW-5 (#15): Workspace control buttons -->
            <VBox styleClass="workspace-controls" spacing="10" alignment="BOTTOM_CENTER">
                <Button fx:id="clearContextBtn" text="Clear Context" styleClass="btn-secondary"
                        maxWidth="Infinity" onAction="#onClearContext"/>
                <Button fx:id="endSessionBtn" text="End Session" styleClass="btn-primary"
                        maxWidth="Infinity" onAction="#onEndSession"/>
            </VBox>
        </VBox>
    </right>

</BorderPane>
