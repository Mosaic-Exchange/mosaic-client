<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<!--
    Main Workspace screen — layout structure only (APP-MW-1, #11).

    Panel content is intentionally left as placeholders.
    Teammates: fill in your assigned panel below:
      - Top header    → APP-MW-4 (#14): active expert status bar
      - Left sidebar  → APP-MW-2 (#12): session list + new/search buttons
      - Center panel  → APP-MW-2 (#12): chat history
                        APP-MW-3 (#13): message input + send
      - Right panel   → APP-MW-4 (#14): expert metadata
                        APP-MW-5 (#15): End Session / Clear Context controls
-->
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mosaic.client.ui.screens.workspace.MainWorkspaceController"
            styleClass="workspace-screen">

    <!-- TOP — expert status header placeholder -->
    <top>
        <HBox styleClass="workspace-header" alignment="CENTER_LEFT" minHeight="52">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <!-- TODO APP-MW-4 (#14): Replace with active expert name, source, mode and Switch Expert button -->
            <Label text="[Header] Active Expert Status — see #14" styleClass="panel-placeholder-label"/>
        </HBox>
    </top>

    <!-- LEFT — session list sidebar placeholder -->
    <left>
        <VBox styleClass="workspace-sidebar" prefWidth="220" alignment="TOP_CENTER">
            <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
            <!-- TODO APP-MW-2 (#12): Replace with New Session button, Search Session button, session list -->
            <Button text="New Session"/>
            <Button text="Search Session"/>
            <ListView fx:id="sessionListView">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Greek Recipes"/>
                        <String fx:value="How to Make Tomatoes Grow"/>
                    </FXCollections>
                </items>
            </ListView>
        </VBox>
    </left>

    <!-- CENTER — chat history + message input placeholder -->
    <center>
        <BorderPane styleClass="chat-panel">
            <center>
                <!-- TODO APP-MW-2 (#12): Replace with scrollable chat history -->
                <Label text="[Center] Chat History — see #12" styleClass="panel-placeholder-label"/>
            </center>
            <bottom>
                <!-- TODO APP-MW-3 (#13): Replace with message TextArea + Send button -->
                <HBox styleClass="input-area" minHeight="60" alignment="CENTER">
                    <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
                    <Label text="[Bottom] Message Input — see #13" styleClass="panel-placeholder-label"/>
                </HBox>
            </bottom>
        </BorderPane>
    </center>

    <!-- RIGHT — expert details panel placeholder -->
    <right>
        <VBox styleClass="expert-panel" prefWidth="200" alignment="TOP_CENTER">
            <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>
            <!-- TODO APP-MW-4 (#14): Replace with expert metadata labels -->
            <!-- TODO APP-MW-5 (#15): Add End Session and Clear Context buttons at bottom -->
            <Label text="[Right] Expert Details — see #14" styleClass="panel-placeholder-label" wrapText="true"/>
        </VBox>
    </right>

</BorderPane>
